# Database Configuration
# If using Supabase:
# DATABASE_URL: Transaction Pooler connection string (port 6543)
# DIRECT_URL: Direct connection string (port 5432) for migrations
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Authentication secret (for session tokens)
AUTH_SECRET="change-this-to-a-random-secret-key-at-least-32-chars-long"

# Email Configuration (Resend)
RESEND_API_KEY="re_123456789"
EMAIL_FROM="Diamond Dental <orders@diamonddental.et>"

# Store Information
NEXT_PUBLIC_STORE_NAME="Diamond Dental"
NEXT_PUBLIC_STORE_PHONE="+251 90 000 0000"
NEXT_PUBLIC_STORE_LOCATION="Bole, Addis Ababa, Ethiopia"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
